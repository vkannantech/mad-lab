<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    android:background="#FFFFFF">

    <!-- College Logo (top-right) -->
    <ImageView
        android:id="@+id/logo"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:src="@mipmap/ic_launcher"
        android:contentDescription="College Logo"/>

    <!-- College Name (capitals, centred) -->
    <TextView
        android:id="@+id/collegeName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/logo"
        android:layout_centerHorizontal="true"
        android:gravity="center"
        android:text="Francis Xavier Engineering College"
        android:textAllCaps="true"
        android:textStyle="bold"
        android:textSize="20sp"
        android:textColor="#000080"/>

    <TextView
        android:id="@+id/studentName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/collegeName"
        android:layout_marginTop="35dp"
        android:text="Name : KANNAN"
        android:textColor="#000000"
        android:textStyle="bold"
        android:textSize="18sp"/>

    <TextView
        android:id="@+id/course"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/studentName"
        android:layout_marginTop="10dp"
        android:text="Course : B.Tech Information Technology"
        android:textColor="#000000"
        android:textSize="17sp"/>

    <!-- Horizontal line -->
    <View
        android:id="@+id/line"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_below="@id/course"
        android:layout_marginTop="12dp"
        android:background="#000000"/>

    <TextView
        android:id="@+id/regno"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/line"
        android:layout_marginTop="12dp"
        android:text="Register No : 22IT001"
        android:textColor="#000000"
        android:textSize="17sp"/>

    <TextView
        android:id="@+id/phone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/regno"
        android:layout_marginTop="10dp"
        android:text="Phone : +91 9876543210"
        android:textColor="#000000"
        android:textSize="17sp"/>

    <TextView
        android:id="@+id/address"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/phone"
        android:layout_marginTop="10dp"
        android:text="Address : Tirunelveli, Tamil Nadu"
        android:textColor="#000000"
        android:textSize="17sp"/>

    <TextView
        android:id="@+id/email"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/address"
        android:layout_marginTop="10dp"
        android:text="Email : kannan22it@fxec.edu.in"
        android:textColor="#000000"
        android:textSize="17sp"/>

    <TextView
        android:id="@+id/dept"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/email"
        android:layout_marginTop="10dp"
        android:text="Department : Information Technology"
        android:textColor="#000000"
        android:textSize="17sp"/>

    <TextView
        android:id="@+id/website"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/dept"
        android:layout_marginTop="10dp"
        android:text="Website : www.francisxavier.ac.in"
        android:textColor="#000000"
        android:textSize="17sp"/>
</RelativeLayout>
